{
  "expo": {
    "name": "React Native Lessons",
    "slug": "react_native_lessons",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/ourIcon/our_icon.png",
    "scheme": "pv411412reactnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pv412411.rncourses",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pv412411.rncourses",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#741B7C",
        "foregroundImage": "./assets/images/ourIcon/our_icon_foreground.png",
        "backgroundImage": "./assets/images/ourIcon/our_icon_background.png",
        "monochromeImage": "./assets/images/ourIcon/our_icon_monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#741B7C",
          "image": "./assets/images/ourIcon/our_splash_icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "057cd3fb-d23b-41c9-ac6c-ccc68bcf7d80"
      }
    }
  }
}
